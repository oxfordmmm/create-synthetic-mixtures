// mix_pipeline/nextflow.config

workDir = '/mnt/volume_1/data/genome_analysis/work_mix_pipeline'

// Defaults so accessing these before a -params-file is merged doesn't warn;
// main.nf still errors out with a clear message if backgrounds ends up empty.
params {
    backgrounds = []
    outdir      = './mixes'
}

conda.enabled = true

executor {
    cpus   = 63
    memory = 252.GB
}

process {
    withLabel: 'mapping' {
        conda  = "${projectDir}/envs/mapping.yml"
        cpus   = 16
        memory = 32.GB
    }
    withLabel: 'ont_map' {
        conda  = "${projectDir}/envs/mapping.yml"
        cpus   = 4
        memory = 16.GB
    }
    withLabel: 'mix_reads' {
        conda  = "${projectDir}/envs/mix.yml"
        cpus   = 1
        memory = 2.GB
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/logs/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/logs/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/logs/trace.txt" }
